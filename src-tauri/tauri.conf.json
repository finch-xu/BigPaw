{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BigPaw",
  "version": "0.4.0",
  "identifier": "com.bigpaw.app",
  "build": {
    "beforeDevCommand": "pnpm -C ../ui dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm -C ../ui build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "BigPaw · 大脚猫",
        "width": 960,
        "height": 640,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
